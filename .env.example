# CATCHPASS VER.1 환경변수 — 운영 배포 시 전부 필수
# (미설정 시 개발용 폴백으로 동작하지만, 폴백 값은 저장소에 공개되어 있어 운영에서 사용 금지)

# 세션 JWT 서명 키 — 32자 이상 무작위 문자열 (예: openssl rand -base64 48)
AUTH_SECRET=

# Vercel KV (Upstash Redis REST) — 미설정 시 인스턴스 로컬 저장(서버리스에서 데이터 유실 위험)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Naver Cloud Platform Maps
# 저장소 이력에 노출된 기존 키는 폐기하고 재발급하여 사용할 것.
#  - NAVER_MAP_CLIENT_ID       : 서버 API(정적 지도 /api/map/static, 역지오코딩)에서 사용.
#                                탐색 인터랙티브 지도의 client ID로도 폴백된다(별도 NEXT_PUBLIC 미설정 시).
#  - NAVER_MAP_CLIENT_SECRET   : 서버 API 전용 시크릿 (절대 클라이언트 노출 금지).
#  - NEXT_PUBLIC_NAVER_MAP_CLIENT_ID (선택): 브라우저 인터랙티브 지도 SDK 전용 client ID.
#                                미설정 시 NAVER_MAP_CLIENT_ID로 폴백하므로 보통은 이것만 있어도 됨.
# ※ NCP 콘솔 > Maps > 애플리케이션에서 배포 도메인을 "Web 서비스 URL" 허용 목록에 등록해야
#    유효한 키여도 인증 실패(navermap_authFailure) 없이 지도가 뜬다. localhost도 개발용으로 등록.
# ※ 최신 발급 키는 SDK 파라미터가 ncpKeyId (구 키는 ncpClientId) — 현재 코드는 ncpKeyId 사용.
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# 운영 관리자 도구 (매장 데이터 갱신 엔드포인트 보호 토큰)
ADMIN_REFRESH_TOKEN=

# ── SNS 채널 본인 검증 OAuth (2026-07-10) ──
# 채널 연동 시 본인 소유 검증에 사용. 프로바이더별 키가 미설정이면 해당 채널은
# "데모 검증 모드"(자체 승인 화면)로 동작한다 — 실 로그인 검증은 키 설정 시 자동 활성.
# 각 개발자 콘솔에 콜백 URL을 등록해야 한다: {배포 origin}/api/sns/{provider}/callback
#   (provider = naver_blog | instagram | tiktok, localhost도 개발용으로 등록)
#
# 네이버 로그인 (developers.naver.com — Maps 키와 별개 애플리케이션)
#  ※ 네이버 프로필 API는 로그인 아이디(블로그 주소)를 반환하지 않으므로,
#    검증 = "네이버 계정 본인 인증 + 입력한 블로그 URL 귀속" (한계는 운영정책서 §13)
NAVER_LOGIN_CLIENT_ID=
NAVER_LOGIN_CLIENT_SECRET=
# Meta / Facebook Login (developers.facebook.com — 인스타그램 검증)
#  ※ instagram_basic·pages_show_list 권한은 앱 리뷰 필요. 비즈니스/크리에이터 계정 +
#    페이스북 페이지 연결 시 username·팔로워 수까지 조회(best-effort).
META_APP_ID=
META_APP_SECRET=
# TikTok Login Kit (developers.tiktok.com)
#  ※ user.info.basic scope 기본 — username/팔로워 수는 추가 scope 승인 시 조회.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# [테스트 전용 · 비프로덕션 한정] 실 OAuth 코드 경로 통합 테스트용 스텁 프로바이더 베이스.
#  node scripts/sns-oauth-stub.mjs 실행 후 http://127.0.0.1:4400 지정 — production에서는 무시됨.
#  (localhost 대신 127.0.0.1 사용 — Next 서버 fetch가 ::1 해석으로 실패할 수 있음)
SNS_OAUTH_TEST_BASE=

# ── KFTC 오픈뱅킹 — 출금 계좌 본인 인증 (계좌실명조회, 2026-07-12 고도화) ──
# 발급 위치: https://developers.kftc.or.kr (마이페이지 → 앱 정보의 Client ID/Secret)
# ★ 발급받은 키는 이 파일이 아니라 프로젝트 루트의 `.env.local`(git 미추적)에 넣는다:
#     KFTC_CLIENT_ID=발급받은_Client_ID
#     KFTC_CLIENT_SECRET=발급받은_Client_Secret
#   두 값만 넣으면 즉시 테스트베드(testapi.openbanking.or.kr) 계좌실명조회로 동작한다.
#   미설정 시에는 데모 인증 모드(플로우 동일 · via:"demo")로 폴백.
KFTC_CLIENT_ID=
KFTC_CLIENT_SECRET=
# 이용기관코드 10자리 — 테스트베드 문서 예시값("F123456789") 기본. 발급 코드가 다르면 교체.
KFTC_ORG_CODE=
# API 베이스 — 기본 https://testapi.openbanking.or.kr (테스트베드).
#  운영 전환 시 https://openapi.openbanking.or.kr / 통합 테스트 시 스텁(node scripts/kftc-stub.mjs
#  실행 후 http://127.0.0.1:4500) 지정 가능.
KFTC_API_BASE=
