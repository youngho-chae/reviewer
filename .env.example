# CATCHPASS VER.1 환경변수 — 운영 배포 시 전부 필수
# (미설정 시 개발용 폴백으로 동작하지만, 폴백 값은 저장소에 공개되어 있어 운영에서 사용 금지)

# 세션 JWT 서명 키 — 32자 이상 무작위 문자열 (예: openssl rand -base64 48)
AUTH_SECRET=

# Vercel KV (Upstash Redis REST) — 미설정 시 인스턴스 로컬 저장(서버리스에서 인스턴스 간
# 데이터 불일치: 리뷰어 신청이 사장님 홈에 안 보이는 등 cross-actor 미반영 + 유실 위험).
# 연결 방법 (두 값만 있으면 코드가 자동 감지 — src/lib/kv.ts):
#  A. Vercel 대시보드 → 프로젝트 → Storage → Create Database → Upstash (Redis, 구 Vercel KV)
#     → Connect Project(Production+Preview, env 프리픽스 기본 KV 유지) → Redeploy.
#     KV_REST_API_URL/TOKEN이 자동 주입된다.
#  B. upstash.com에서 직접 생성 → REST API의 URL/TOKEN을 아래 이름으로 Vercel 환경변수에 등록.
# 확인: Upstash Data Browser에 "catchpass:db:v1" 키 생성 여부. 초기화 = 키 삭제 또는 SEED_VERSION bump.
# ⚠ 로컬 .env.local에 넣으면 로컬 개발이 배포 DB를 직접 읽고 쓰므로 보통 비워둘 것.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Naver Cloud Platform Maps
# 저장소 이력에 노출된 기존 키는 폐기하고 재발급하여 사용할 것.
#  - NAVER_MAP_CLIENT_ID       : 서버 API(정적 지도 /api/map/static, 역지오코딩)에서 사용.
#                                탐색 인터랙티브 지도의 client ID로도 폴백된다(별도 NEXT_PUBLIC 미설정 시).
#  - NAVER_MAP_CLIENT_SECRET   : 서버 API 전용 시크릿 (절대 클라이언트 노출 금지).
#  - NEXT_PUBLIC_NAVER_MAP_CLIENT_ID (선택): 브라우저 인터랙티브 지도 SDK 전용 client ID.
#                                미설정 시 NAVER_MAP_CLIENT_ID로 폴백하므로 보통은 이것만 있어도 됨.
# ※ NCP 콘솔 > Maps > 애플리케이션에서 배포 도메인을 "Web 서비스 URL" 허용 목록에 등록해야
#    유효한 키여도 인증 실패(navermap_authFailure) 없이 지도가 뜬다. localhost도 개발용으로 등록.
# ※ 최신 발급 키는 SDK 파라미터가 ncpKeyId (구 키는 ncpClientId) — 현재 코드는 ncpKeyId 사용.
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# 운영 관리자 도구 (매장 데이터 갱신 엔드포인트 보호 토큰)
ADMIN_REFRESH_TOKEN=

# ── SNS 채널 본인 검증 OAuth (2026-07-10) ──
# 채널 연동 시 본인 소유 검증에 사용. 프로바이더별 키가 미설정이면 해당 채널은
# "데모 검증 모드"(자체 승인 화면)로 동작한다 — 실 로그인 검증은 키 설정 시 자동 활성.
# 각 개발자 콘솔에 콜백 URL을 등록해야 한다: {배포 origin}/api/sns/{provider}/callback
#   (provider = naver_blog | instagram | tiktok, localhost도 개발용으로 등록)
#
# 네이버 로그인 (developers.naver.com — Maps 키와 별개 애플리케이션)
#  ※ 네이버 프로필 API는 로그인 아이디(블로그 주소)를 반환하지 않으므로,
#    검증 = "네이버 계정 본인 인증 + 입력한 블로그 URL 귀속" (한계는 운영정책서 §13)
NAVER_LOGIN_CLIENT_ID=
NAVER_LOGIN_CLIENT_SECRET=
# Meta / Facebook Login (developers.facebook.com — 인스타그램 검증)
#  ※ instagram_basic·pages_show_list 권한은 앱 리뷰 필요. 비즈니스/크리에이터 계정 +
#    페이스북 페이지 연결 시 username·팔로워 수까지 조회(best-effort).
META_APP_ID=
META_APP_SECRET=
# TikTok Login Kit (developers.tiktok.com)
#  ※ user.info.basic scope 기본 — username/팔로워 수는 추가 scope 승인 시 조회.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# [테스트 전용 · 비프로덕션 한정] 실 OAuth 코드 경로 통합 테스트용 스텁 프로바이더 베이스.
#  node scripts/sns-oauth-stub.mjs 실행 후 http://127.0.0.1:4400 지정 — production에서는 무시됨.
#  (localhost 대신 127.0.0.1 사용 — Next 서버 fetch가 ::1 해석으로 실패할 수 있음)
SNS_OAUTH_TEST_BASE=

# ── KFTC 오픈뱅킹 — 출금 계좌 본인 인증 (계좌실명조회, 2026-07-12 고도화) ──
# 발급 위치: https://developers.kftc.or.kr (마이페이지 → 앱 정보의 Client ID/Secret)
# ★ 발급받은 키는 이 파일이 아니라 프로젝트 루트의 `.env.local`(git 미추적)에 넣는다.
#   ⚠ `.env.local`은 **로컬 개발 전용** — 배포(dev 브랜치 배포 포함)에는 적용되지 않는다.
#     배포 환경 실 인증: Vercel 대시보드 → Settings → Environment Variables에
#     KFTC_CLIENT_ID / KFTC_CLIENT_SECRET을 추가(Preview+Production 체크) 후 Redeploy.
#     KFTC_CLIENT_ID=발급받은_Client_ID
#     KFTC_CLIENT_SECRET=발급받은_Client_Secret
#   두 값만 넣으면 즉시 테스트베드(testapi.openbanking.or.kr) 계좌실명조회로 동작한다.
#   미설정 시에는 데모 인증 모드(플로우 동일 · via:"demo")로 폴백.
KFTC_CLIENT_ID=
KFTC_CLIENT_SECRET=
# 이용기관코드 10자리 — 보통 설정 불필요: 토큰 응답의 client_use_code를 자동 사용한다
# (bank_tran_id 앞자리 불일치 "요청전문 포맷 에러" 방지). 수동 지정 시에만 입력.
KFTC_ORG_CODE=
# API 베이스 — 미설정 시 환경 기본값: **배포(Vercel/production) = 운영망**
#  https://openapi.openbanking.or.kr (2026-07-16 — Vercel에 등록된 실키로 실계좌 실명조회),
#  **로컬 개발 = 테스트베드** https://testapi.openbanking.or.kr.
#  명시 지정으로 어느 환경이든 오버라이드 가능 (통합 테스트 스텁: node scripts/kftc-stub.mjs
#  실행 후 http://127.0.0.1:4500 / 배포에서 테스트베드 사용 시 testapi 주소 지정).
# ★ 실계좌 인증 조건 — 테스트베드는 은행에 연결되지 않은 **시뮬레이터**라 실제 계좌는
#   조회되지 않는다(마이페이지→테스트 관리→테스트 데이터 관리에 등록한 조합만 응답).
#   실계좌 검증 = 운영망 + KFTC 이용기관 등록·승인 후 발급되는 운영 Client ID/Secret.
#   테스트베드용 키로 운영망을 호출하면 토큰 발급부터 실패한다(화면에 원인 표시).
#   테스트베드 배너·예금주 힌트는 운영망에서 자동 비활성.
KFTC_API_BASE=
# 콘솔의 Callback URL 등록값 (앱 정보 필수 입력 — 코드 변경 불필요, 주소만 등록):
#   로컬:  http://localhost:3000/api/openbanking/callback
#   배포:  https://{배포 도메인}/api/openbanking/callback
#  현행 계좌실명조회(2-legged)는 콜백을 호출하지 않으며, 3-legged 확장 대비 안착 라우트가
#  /api/openbanking/callback 에 구현되어 있다.

# ── 체험자 가입·간편로그인 (2026-07-23) ──
# 휴대폰 인증 SMS — 솔라피(SOLAPI). 세 값 모두 설정 시 실제 문자 발송,
# 미설정 시 데모 모드(발송 응답에 인증번호 포함 — 화면 "데모 모드" 배너로 노출·실발송 없음).
# 인증번호·증빙은 서버에 저장하지 않고 AUTH_SECRET 서명 쿠키(OTP 5분·증빙 15분)로만 왕복한다.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=
# 네이버 간편로그인 — 채널 본인 검증과 같은 네이버 앱 재사용 가능.
# 콘솔 Callback URL에 https://{도메인}/api/auth/social/naver/callback 추가 등록 필요.
# (NAVER_LOGIN_CLIENT_ID/SECRET — 위 SNS 검증 섹션과 공유)
# 카카오 간편로그인 — developers.kakao.com 앱의 REST API 키.
# Redirect URI: https://{도메인}/api/auth/social/kakao/callback (클라이언트 시크릿은 콘솔에서
# 활성화한 경우에만 설정). 미설정 시 데모 로그인 폴백(/r/login/social-demo).
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# 네이버 플레이스 스크랩 베이스 오버라이드 (로컬 스텁 검증용 — 미설정 시 실 네이버 도메인)
# 샌드박스 등 네이버 차단 환경: node scripts/place-stub.mjs 실행 후 아래 설정
# NAVER_PLACE_BASE=http://127.0.0.1:4210
# NAVER_PCMAP_BASE=http://127.0.0.1:4210

# KV DB 네임스페이스 (선택) — 미설정 시 Vercel 배포 브랜치명(VERCEL_GIT_COMMIT_REF), 로컬은 "local".
# 같은 Vercel 프로젝트에서 여러 브랜치를 배포할 때 브랜치별 DB가 자동 분리된다.
# CATCHPASS_DB_NS=my-branch

# SNS 소개글 인증 크롤링·블로그 등급평가 베이스 오버라이드 (로컬 스텁 검증용 — 미설정 시 실 도메인)
# node scripts/sns-bio-stub.mjs 실행 후:
# NAVER_BLOG_CRAWL_BASE=http://127.0.0.1:4700
# INSTAGRAM_CRAWL_BASE=http://127.0.0.1:4700/ig
# INSTAGRAM_APP_API_BASE=http://127.0.0.1:4700/igapp
# TIKTOK_CRAWL_BASE=http://127.0.0.1:4700/tt
# BLOG_ANALYZER_BASE=http://127.0.0.1:4700
# INSTA_INDEX_BASE=http://127.0.0.1:4700

# 인스타그램 캡처 인증 — 네이버 클라우드 플랫폼 CLOVA OCR (2026-07-28)
# NCP 콘솔 → CLOVA OCR 도메인 → API Gateway 연동에서 발급한 값 2개를 입력하면 즉시 구동.
# (배포는 Vercel 프로젝트 환경변수에 동일 키로 등록 — Production/Preview 모두)
# NCP_OCR_INVOKE_URL=https://xxxxx.apigw.ntruss.com/custom/v1/.../general
# NCP_OCR_SECRET=발급된 Secret Key
# 로컬 스텁 검증: NCP_OCR_INVOKE_URL=http://127.0.0.1:4700/ocr · NCP_OCR_SECRET=test-secret

# ── 웹푸시 (2026-08-13 — 실제 모바일 푸시, 정본 src/lib/push.ts) ──────────────
# 발급: npx web-push generate-vapid-keys  (공개키는 클라이언트 구독에도 사용)
# 미설정 시 푸시 켜기 UI 미노출·발송 스킵 — 인앱 알림함은 그대로 동작.
# 배포는 Vercel 환경변수에 동일 키 등록 (Production/Preview).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 푸시 서비스에 전달되는 연락처 (기본 mailto:help@catchrank.co.kr)
# VAPID_SUBJECT=mailto:help@catchrank.co.kr

# ── 사업자등록 진위확인 (2026-08-18 — 즉시 승인, 정본 src/lib/biz-verify.ts) ────
# 공공데이터포털 「국세청_사업자등록정보 진위확인 및 상태조회」 서비스 키 (Decoding 키).
# 미설정 시 데모 폴백: 10자리 형식이면 존재로 간주(끝자리 0은 미존재 — 실패 경로 QA용).
NTS_API_KEY=
# 스텁/테스트용 베이스 오버라이드 (기본 https://api.odcloud.kr/api/nts-businessman/v1)
# NTS_API_BASE=

# ── 결제 테스트 모듈 (2026-08-30 — 정본 src/lib/payment.ts) ──────────────────
# 최종 결제 버튼(리필권 구매·플랜 구독·연간 전환)이 새 탭으로 여는 다날 테스트 결제창.
# 미설정 시 코드 기본값(고정 링크) 사용 — 실 PG 전환 시 payment.ts 교체.
# NEXT_PUBLIC_PAYMENT_TEST_URL=
