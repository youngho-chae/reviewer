# CATCHPASS VER.1 환경변수 — 운영 배포 시 전부 필수
# (미설정 시 개발용 폴백으로 동작하지만, 폴백 값은 저장소에 공개되어 있어 운영에서 사용 금지)

# 세션 JWT 서명 키 — 32자 이상 무작위 문자열 (예: openssl rand -base64 48)
AUTH_SECRET=

# Vercel KV (Upstash Redis REST) — 미설정 시 인스턴스 로컬 저장(서버리스에서 데이터 유실 위험)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Naver Cloud Platform Maps (Static Map / Reverse Geocoding)
# 저장소 이력에 노출된 기존 키는 폐기하고 재발급하여 사용할 것
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

# 운영 관리자 도구 (매장 데이터 갱신 엔드포인트 보호 토큰)
ADMIN_REFRESH_TOKEN=
